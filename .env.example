# Every key is optional. A missing key degrades to a no-op with one dev warning.

# PostHog project API key (public by design)
PUBLIC_POSTHOG_KEY=

# Browser ingestion host. Set to /rly in production to route through the same-origin
# proxy in vercel.json (ad blockers drop requests to us.i.posthog.com). Leave the
# PostHog URL in local dev: `astro dev` does not apply vercel.json rewrites.
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# production | preview | development. Tags every event so non-production traffic can
# be filtered out in one place (PostHog › internal and test users).
PUBLIC_APP_ENV=development

# Server ingestion host: always PostHog itself, never the browser proxy path.
POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis. Missing => in-memory store (per instance, resets on cold start).
# The Vercel Marketplace integration may create KV_REST_API_URL / KV_REST_API_TOKEN
# instead: copy their values into these two names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token for GET /api/users and admin PATCH.
# Missing => the list is open in dev and returns 404 in production.
USERS_ADMIN_TOKEN=
